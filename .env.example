# ==============================================================================
# PulseDesk AI — Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# Note: PulseDesk includes a zero-config deterministic demo mode out of the box!
# ==============================================================================

# Core Application Settings
APP_NAME=PulseDesk
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8008

# Database Persistence
# Default: Zero-config SQLite (with async driver)
DATABASE_URL=sqlite+aiosqlite:///./pulsedesk.db
# Production: PostgreSQL with pgvector
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulsedesk

# LLM Orchestration Provider (auto, openai, gemini, or demo)
DEFAULT_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# GitHub MCP Connector
# Optional: Leave blank to run offline demo fixtures for 'pulsedesk/project-alpha'
GITHUB_TOKEN=
DEFAULT_GITHUB_REPO=pulsedesk/project-alpha

# Gmail OAuth 2.0 Connector (Strict Read-Only)
# Optional: Leave blank to use offline deterministic demo threads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8008/api/connections/gmail/callback

# Observability & Tracing (LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pulsedesk
